# SawserQ GPT Configuration
# Copy this file to .env and modify as needed

# Application settings
APP_NAME=SawserQ GPT
APP_VERSION=2.0.0
DEBUG=false

# Model settings
LLM_MODEL_NAME=microsoft/DialoGPT-medium
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
MAX_TOKENS=512
TEMPERATURE=0.7
TOP_K=3

# Vector database settings
PERSIST_DIR=./storage
CHUNK_SIZE=256
CHUNK_OVERLAP=25
SIMILARITY_CUTOFF=0.5

# Resources directory
RESOURCES_DIR=./resources

# Server settings
HOST=0.0.0.0
PORT=8000
WORKERS=1

# GPU settings (set to true if you have CUDA available)
USE_GPU=false
DEVICE=cpu
